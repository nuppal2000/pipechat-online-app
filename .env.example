OPENAI_API_KEY=
PIPECHAT_MODEL=gpt-5.2
PIPECHAT_FREE_CHAT_LIMIT=1000
PORT=8787

# Supported: json (local development), supabase (hosted app).
# Never silently falls back between providers.
PIPECHAT_STORAGE_PROVIDER=json
# Closed test rollout: existing accounts only. Also disable signups in Supabase Auth.
PIPECHAT_ALLOW_SIGNUP=false

# Local JSON storage. Ignored by cloud providers; never a fallback.
PIPECHAT_DATA_DIR=./data

# New Supabase project. Do not use a service-role key or a database password here.
# Apply all db/migrations in order to a new project before verification.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Production: use the exact HTTPS app origin and secure cookies.
# PIPECHAT_PUBLIC_ORIGIN=https://your-app.onrender.com
# PIPECHAT_COOKIE_SECURE=true

# Future payment settings.
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_ID=
