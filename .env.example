OPENAI_API_KEY=
PIPECHAT_MODEL=gpt-5.5
PIPECHAT_FREE_CHAT_LIMIT=1000
PORT=8787

# Keep the currently deployed provider until the replacement passes live checks.
# Supported: json, xano, supabase. Never silently falls back between providers.
PIPECHAT_STORAGE_PROVIDER=json
# Closed test rollout: existing accounts only. Also disable signups in Supabase Auth.
PIPECHAT_ALLOW_SIGNUP=false

# Local JSON storage. Ignored by cloud providers; never a fallback.
PIPECHAT_DATA_DIR=./data

# Xano application API group URL, not its metadata API or workspace dashboard URL.
XANO_API_BASE_URL=
# Private random server-to-server key. Match PIPECHAT_SERVER_KEY in Xano.
XANO_SERVER_KEY=

# New Supabase project. Do not use a service-role key or a database password here.
# Apply db/migrations/001-supabase.sql and complete staging verification first.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Production: use the exact HTTPS app origin and secure cookies.
# PIPECHAT_PUBLIC_ORIGIN=https://your-app.onrender.com
# PIPECHAT_COOKIE_SECURE=true

# Optional dedicated test account for `npm run xano:check -- --account`.
# XANO_TEST_EMAIL=
# XANO_TEST_PASSWORD=

# Future payment settings.
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_ID=
